DATABASE_URL="postgresql://user:password@localhost:5432/du_student_db"
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-refresh-secret"
PORT=4000

# Optional. Comma-separated origins allowed by CORS (the Flutter app sends no Origin, so it is unaffected).
CORS_ORIGINS="http://localhost:3000"
# Optional. Number of reverse proxies in front of the API (Railway/Render: 1), so rate limiting sees real client IPs.
TRUST_PROXY=0

# Hosted only.
# The admin account is created or updated from these each time the server starts. At least 12 characters.
# ADMIN_PASSWORD=""
# ADMIN_USERNAME="admin"
# ADMIN_EMAIL="you@example.com"
# Folder for uploaded files. Must be on a persistent volume, such as /data/uploads.
# UPLOAD_DIR="/data/uploads"
